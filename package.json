{
  "name": "svefnvinur",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "preview:showcase": "vite preview --outDir dist-showcase",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "build:showcase": "tsc --noEmit && vite build --mode showcase --outDir dist-showcase && node scripts/showcase-page.mjs",
    "test": "vitest run",
    "contrast": "node scripts/contrast.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run contrast && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "lucide-react": "^0.540.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.8",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
